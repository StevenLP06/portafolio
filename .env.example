# Copia este archivo a ".env" y reemplaza los valores con tus credenciales
# reales de EmailJS (https://www.emailjs.com/). Nunca commitees el archivo
# ".env" con claves reales — ya está ignorado en .gitignore.

VITE_EMAILJS_SERVICE_ID=tu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=tu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=tu_public_key_aqui
